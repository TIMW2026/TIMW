pkgname=vkd3d-proton-mingw-git
pkgver=3.0.1.r407.g5d0db741
pkgrel=1
arch=('x86_64')
depends=('vulkan-icd-loader' 'wine' 'bash')
makedepends=('ninja' 'meson' 'glslang' 'git' 'mingw-w64-gcc' 'mingw-w64-tools')
source=("git+https://github.com/HansKristian-Work/vkd3d-proton.git" "vkd3d-proton-extraopts.patch" "setup_vkd3d_proton.sh" "setup_vkd3d_proton")
sha512sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

pkgver() {
    cd vkd3d-proton
    printf "%s" "$(git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/v//g')"
}

prepare() {
    cd vkd3d-proton
    git remote set-url origin https://github.com/HansKristian-Work/vkd3d-proton.git
    git submodule update --init --filter=tree:0 --recursive
    patch -p1 -i "$srcdir"/vkd3d-proton-extraopts.patch

    COMMON_FLAGS="-march=native -mtune=native -O3 -pipe -g0"
    COMMON_LDFLAGS="-Wl,-O1,--sort-common,--as-needed -Wl,--file-alignment,4096"

    export CFLAGS="$COMMON_FLAGS -mcmodel=small"
    export CXXFLAGS="$COMMON_FLAGS -mcmodel=small"
    export LDFLAGS="$COMMON_LDFLAGS"

    local cross_cflags="$COMMON_FLAGS -mcmodel=small"
    local cross_cxxflags="$COMMON_FLAGS -mcmodel=small"
    local cross_ldflags="$COMMON_LDFLAGS"
    sed -i build-win64.txt \
        -e "s|@CARGS@|\'${cross_cflags// /\',\'}\'|g" \
        -e "s|@CXXARGS@|\'${cross_cxxflags// /\',\'}\'|g" \
        -e "s|@LDARGS@|\'${cross_ldflags// /\',\'}\'|g"

    local cross_cflags="$COMMON_FLAGS -mstackrealign -mpreferred-stack-boundary=2"
    local cross_cxxflags="$COMMON_FLAGS -mstackrealign -mpreferred-stack-boundary=2"
    sed -i build-win32.txt \
        -e "s|@CARGS@|\'${cross_cflags// /\',\'}\'|g" \
        -e "s|@CXXARGS@|\'${cross_cxxflags// /\',\'}\'|g" \
        -e "s|@LDARGS@|\'${cross_ldflags// /\',\'}\'|g"
}

build() {
    meson setup vkd3d-proton "build/x64" \
        --prefix "/usr/share/vkd3d-proton/x64" \
        --cross-file vkd3d-proton/build-win64.txt \
        --bindir "" --libdir "" \
        --buildtype "release" \
        -Db_ndebug=true \
        --strip
    ninja -j"$(nproc)" -C "build/x64" -v

    meson setup vkd3d-proton "build/x86" \
        --prefix "/usr/share/vkd3d-proton/x86" \
        --cross-file vkd3d-proton/build-win32.txt \
        --bindir "" --libdir "" \
        --buildtype "release" \
        -Db_ndebug=true \
        --strip
    ninja -j"$(nproc)" -C "build/x86" -v
}

package() {
    provides=('vkd3d-proton')
    conflicts=('vkd3d-proton')
    DESTDIR="$pkgdir" ninja -j"$(nproc)" -C "build/x86" install
    DESTDIR="$pkgdir" ninja -j"$(nproc)" -C "build/x64" install
    install -Dm 755 -t "$pkgdir/usr/share/vkd3d-proton" setup_vkd3d_proton.sh
    install -Dm 755 -t "$pkgdir/usr/bin" setup_vkd3d_proton
}
